# Application Runtime Mode:
# - Leave unset or "firebase" to run against Firebase project academy-0007 (via firebase-applet-config.json).
# - Set to "local_demo" in local development ONLY to use the isolated browser localStorage DEMO DATA adapter.
#   Production builds (vite build) never fall back to local demo data.
VITE_APP_DATA_MODE="firebase"

# Cloud Functions Deployment Flag:
# - Set to "true" only after deploying /functions to Firebase (Blaze plan required for Cloud Functions).
# - When "false", privileged server operations display explicit setup instructions instead of faking backend authority.
VITE_FIREBASE_FUNCTIONS_ENABLED="false"

# Optional Public Client Firebase Overrides (defaults come from firebase-applet-config.json)
# NOTE: Client Firebase config values (apiKey, authDomain, projectId, storageBucket, appId) are PUBLIC
# browser identifiers protected by Firebase Security Rules and App Check.
# NEVER put Admin SDK service-account private keys, FIREBASE_TOKEN, or database secrets in VITE_* variables.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="academy-0007"
VITE_FIREBASE_STORAGE_BUCKET="academy-0007.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Hosted Application URL (used by Cloud Run runtime / self-referential documentation)
APP_URL="MY_APP_URL"

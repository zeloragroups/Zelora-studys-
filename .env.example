# Application Runtime Mode:
# - Leave unset or "firebase" to run against Firebase project academy-0007.
# - Set to "local_demo" in local development ONLY to use the isolated browser localStorage DEMO DATA adapter.
#   Production builds (vite build) never fall back to local demo data.
VITE_APP_DATA_MODE="firebase"

# Firebase Plan Mode (Spark Free Plan Only):
# - Keep "false" to operate 100% on the Firebase Spark (free) plan with zero Cloud Functions or Blaze billing.
# - Account provisioning uses an isolated secondary Firebase Auth app or manual Console UID linking.
VITE_FIREBASE_FUNCTIONS_ENABLED="false"

# Public Client Firebase Web App Configuration (project academy-0007)
# NOTE: Client Firebase config values (apiKey, authDomain, projectId, storageBucket, appId) are PUBLIC
# browser identifiers protected by Firebase Security Rules and App Check.
# NEVER put Admin SDK service-account private keys, FIREBASE_TOKEN, or database secrets in VITE_* variables.
VITE_FIREBASE_API_KEY="AIzaSyAAt6XAwe3W3FPPe19h3ECuJNW2-A4uPxM"
VITE_FIREBASE_AUTH_DOMAIN="academy-0007.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="academy-0007"
VITE_FIREBASE_STORAGE_BUCKET="academy-0007.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123258533376"
VITE_FIREBASE_APP_ID="1:123258533376:web:7995a1487a239015b44ae5"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-tuitioncentreman-6b2667d2-c24a-4077-b286-962e1941f470"
VITE_FIREBASE_MEASUREMENT_ID="G-4P37NTXP0R"

# Hosted Application URL (used by Cloud Run runtime / self-referential documentation)
APP_URL="MY_APP_URL"
